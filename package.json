{
  "name": "sloth",
  "productName": "Sloth",
  "version": "0.6.9",
  "description": "Sloth: varias cuentas de Claude Code, cada una en su PowerShell y su repo. Liviano a propósito.",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run build:daemon && electron-vite dev",
    "build": "electron-vite build && npm run build:daemon",
    "build:daemon": "node scripts/build-daemon.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:css": "node scripts/lint-css.mjs --todo",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/test-hooks.mjs --test \"src/**/*.test.ts\"",
    "dist": "npm run build && electron-builder --win",
    "release": "node scripts/release.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rolldown": "^1.2.16",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.tomy.sloth",
    "productName": "Sloth",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "!out/daemon/**",
      "package.json",
      "!**/node_modules/node-pty/{src,deps,third_party,scripts,typings,build}/**",
      "!**/node_modules/node-pty/prebuilds/{darwin-arm64,darwin-x64,win32-arm64,linux-x64,linux-arm64}/**",
      "!**/node_modules/node-pty/**/*.{pdb,md,ts,map}"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "out/daemon/sloth-daemon.cjs",
        "to": "daemon/sloth-daemon.cjs"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sloth",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Sloth-Setup-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Toomasmg",
        "repo": "sloth",
        "releaseType": "release"
      }
    ]
  },
  "author": "Tomy"
}
